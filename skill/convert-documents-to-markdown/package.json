{
  "name": "convert-documents-to-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone convert skill: PDF/EPUB to Markdown package under OPEN_POD_CONVERT_DATA_DIR/skill-jobs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "convert": "node scripts/convert.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync-books": "node scripts/sync-books.mjs",
    "archive": "node scripts/convert.mjs --archive-only"
  },
  "dependencies": {
    "epub2md": "^1.6.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "undici": "^8.8.0"
  }
}
